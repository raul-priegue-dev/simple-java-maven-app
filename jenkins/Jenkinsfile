pipeline {
    agent any
    environment {   // Definicion de vars
        def myString = "Hello World"
        def myNumber = 10
        def myBool = true
    }
    parameters {  // Definicion de parámetros
        booleanParam(defaultValue: true, description: "Enable Service ?", name: "myBoolean")
        string(defaultValue: "TEST", description: "Environment ?", name: "deployEnv")
        choice(choices: ["TEST", "DEV", "QA", "PROD"], description: "Environment 2 ?", name: "deployEnv2")
    }
    stages {
        stage('Build') {
            steps {
                sh """mvn -B -DskipTests 
                clean package"""        // Multiline shell command
                sleep(30)  // Sleep for 30 seconds to simulate a long build process
            }
        }
        stage('Test') {
            steps {
                sh 'mvn test'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }
        stage('Deliver') {
            steps {
                sh './jenkins/scripts/deliver.sh'
            }
        }
        stage('Complete') {
            steps {
                echo 'Job Complete Guys!'
                echo "myBoolean value = ${params.myBoolean} environment = ${deployEnv}\n"
                echo "environment 2 = ${deployEnv2}\n"
                echo "var myString = ${myString}\n"
                echo "var myNumber = ${myNumber}\n"
                echo "var myBool = ${myBool}\n"
                echo "Running ${env.BUILD_ID} on ${env.JENKINS_URL}"        // Vars de entorno predefinidas
                myFunction("Hello from function", 42)  // Llamada a la función definida fuera del bloque pipeline
                script {   // Bloque de script para definir variables y ejecutar código Groovy
                    if (params.myBoolean == true) {
                        echo "myBoolean is true"
                        currentBuild.description = "This is a test build for ${deployEnv} environment"
                        currentBuild.displayName = "#${env.BUILD_ID} - ${deployEnv}"
                        currentBuild.result = "SUCCESS"
                    } else {
                        echo "myBoolean is false"
                    }
                    def myVar = "Hello from script block"
                    echo "myVar = ${myVar}\n"
                }
            }
        }
    }
}

def myFunction(String param, int number) {
    def myLocalVar = "Hello from myFunction"
    echo "myLocalVar = ${myLocalVar}\n"
    echo "This is a function defined outside the pipeline block"
    echo "param = ${param}, number = ${number}"
}
